@host = http://localhost:5220
@seedAdminEmail = admin@clinic.ge
@seedAdminPassword = Admin123!
@emailTestMailbox = 23202226@ibsu.edu.ge
@visitDate = 2026-11-16


### 1. Sign in as the seeded SuperAdmin
# @name loginSuperAdmin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{seedAdminEmail}}",
  "password": "{{seedAdminPassword}}"
}


### 2. Check the signed-in user's role
GET {{host}}/api/auth/me
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}


### 3. Create Family Medicine specialty
# @name createFamilyMedicine
POST {{host}}/api/specialties
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "name": "Family Medicine",
  "isFamilyMedicine": true,
  "requiresReferral": false
}


### 4. Create a referral-required specialty
# @name createCardiology
POST {{host}}/api/specialties
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "name": "Cardiology",
  "isFamilyMedicine": false,
  "requiresReferral": true
}


### 5. Create a receptionist account
# @name createReceptionist
POST {{host}}/api/staff/receptionists
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "Receptionist",
  "personalNumber": "10000000001",
  "phone": "555000001",
  "email": "receptionist@example.com",
  "password": "TestPass123!"
}


### 6. Create a Family Medicine doctor account
# @name createFamilyDoctor
POST {{host}}/api/doctors
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "firstName": "Family",
  "lastName": "Doctor",
  "personalNumber": "20000000002",
  "phone": "555000002",
  "email": "family.doctor@example.com",
  "password": "TestPass123!",
  "specialtyId": {{createFamilyMedicine.response.body.$.data.id}}
}


### 7. Create a Cardiology doctor account
# @name createCardiologyDoctor
POST {{host}}/api/doctors
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "firstName": "Heart",
  "lastName": "Doctor",
  "personalNumber": "30000000003",
  "phone": "555000003",
  "email": "cardiology.doctor@example.com",
  "password": "TestPass123!",
  "specialtyId": {{createCardiology.response.body.$.data.id}}
}


### 8. Give the Family Medicine doctor a Monday schedule, 08:00–12:00
# Monday is 1 for .NET DayOfWeek.
# @name createFamilyDoctorSchedule
POST {{host}}/api/doctors/{{createFamilyDoctor.response.body.$.data.id}}/schedules
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "dayOfWeek": 1,
  "startTime": "08:00:00",
  "endTime": "12:00:00"
}


### 9. Give the Cardiology doctor a Monday schedule, 13:00–17:00
# @name createCardiologySchedule
POST {{host}}/api/doctors/{{createCardiologyDoctor.response.body.$.data.id}}/schedules
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "dayOfWeek": 1,
  "startTime": "13:00:00",
  "endTime": "17:00:00"
}


### 10. Check the doctors and their schedules
GET {{host}}/api/doctors
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}

###
GET {{host}}/api/doctors/{{createFamilyDoctor.response.body.$.data.id}}/schedules
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}

###
GET {{host}}/api/doctors/{{createCardiologyDoctor.response.body.$.data.id}}/schedules
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}


### 11. Create a patient assigned to the Family Medicine doctor
# @name createTestPatient
POST {{host}}/api/patients
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "firstName": "Email",
  "lastName": "Testpatient",
  "personalNumber": "40000000004",
  "phone": "555000004",
  "birthDate": "1995-05-20",
  "familyDoctorId": {{createFamilyDoctor.response.body.$.data.id}},
  "contactEmail": "{{emailTestMailbox}}"
}


### 12. Check the new patient
GET {{host}}/api/patients/{{createTestPatient.response.body.$.data.id}}
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}


### 13. Create the patient's medical profile
POST {{host}}/api/patients/{{createTestPatient.response.body.$.data.id}}/medical-profile
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "bloodType": "O+",
  "allergies": "No known allergies",
  "chronicConditions": "None"
}


### 14. Check the patient's medical profile
GET {{host}}/api/patients/{{createTestPatient.response.body.$.data.id}}/medical-profile
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}


### 15. Get the Family Medicine doctor's open slots
# @name familyDoctorSlots
GET {{host}}/api/doctors/{{createFamilyDoctor.response.body.$.data.id}}/available-slots?date={{visitDate}}
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}


### 16. Book the patient with the Family Medicine doctor
# Run only if request 15 returned at least one slot.
# A booking confirmation should be sent to emailTestMailbox.
# @name bookFamilyMedicineVisit
POST {{host}}/api/appointments
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "patientId": {{createTestPatient.response.body.$.data.id}},
  "doctorId": {{createFamilyDoctor.response.body.$.data.id}},
  "startTime": "{{familyDoctorSlots.response.body.$.data[0].startTime}}"
}


### 17. Check the new appointment
GET {{host}}/api/appointments/{{bookFamilyMedicineVisit.response.body.$.data.id}}
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}


### 18. Check the patient's appointment list
GET {{host}}/api/patients/{{createTestPatient.response.body.$.data.id}}/appointments
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}


### 19. Try booking the same slot again — this should fail
POST {{host}}/api/appointments
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "patientId": {{createTestPatient.response.body.$.data.id}},
  "doctorId": {{createFamilyDoctor.response.body.$.data.id}},
  "startTime": "{{familyDoctorSlots.response.body.$.data[0].startTime}}"
}


### 20. Sign in as the Family Medicine doctor
# @name loginFamilyDoctor
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "family.doctor@example.com",
  "password": "TestPass123!"
}


### 21. The doctor creates a referral to Cardiology
# @name createReferral
POST {{host}}/api/patients/{{createTestPatient.response.body.$.data.id}}/referrals
Authorization: Bearer {{loginFamilyDoctor.response.body.$.data.token}}
Content-Type: application/json

{
  "toSpecialtyId": {{createCardiology.response.body.$.data.id}},
  "reason": "Cardiology assessment requested",
  "validForDays": 30
}


### 22. Check the patient's referrals
GET {{host}}/api/patients/{{createTestPatient.response.body.$.data.id}}/referrals?activeOnly=true
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}


### 23. Get the Cardiology doctor's open slots
# @name cardiologySlots
GET {{host}}/api/doctors/{{createCardiologyDoctor.response.body.$.data.id}}/available-slots?date={{visitDate}}
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}


### 24. Try booking Cardiology without a referral — this should fail
POST {{host}}/api/appointments
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "patientId": {{createTestPatient.response.body.$.data.id}},
  "doctorId": {{createCardiologyDoctor.response.body.$.data.id}},
  "startTime": "{{cardiologySlots.response.body.$.data[0].startTime}}"
}


### 25. Book Cardiology with the referral
# @name bookCardiologyVisit
POST {{host}}/api/appointments
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}
Content-Type: application/json

{
  "patientId": {{createTestPatient.response.body.$.data.id}},
  "doctorId": {{createCardiologyDoctor.response.body.$.data.id}},
  "startTime": "{{cardiologySlots.response.body.$.data[0].startTime}}",
  "referralId": {{createReferral.response.body.$.data.id}}
}


### 26. Cancel the Cardiology appointment
# This should release the referral for reuse.
POST {{host}}/api/appointments/{{bookCardiologyVisit.response.body.$.data.id}}/cancel
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}


### 27. Check that the referral is available again
GET {{host}}/api/patients/{{createTestPatient.response.body.$.data.id}}/referrals?activeOnly=true
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}


### 28. Sign in as the receptionist
# @name loginReceptionist
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "receptionist@example.com",
  "password": "TestPass123!"
}


### 29. Receptionist can view patients
GET {{host}}/api/patients
Authorization: Bearer {{loginReceptionist.response.body.$.data.token}}


### 30. Receptionist cannot view the admin list — this should return 403
GET {{host}}/api/staff/admins
Authorization: Bearer {{loginReceptionist.response.body.$.data.token}}


### 31. Register a patient account through self-registration
# @name registerSelfPatient
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Self",
  "lastName": "Registered",
  "personalNumber": "50000000005",
  "phone": "555000005",
  "birthDate": "2000-01-15",
  "email": "self.patient@example.com",
  "password": "TestPass123!"
}


### 32. Sign in as the self-registered patient
# @name loginSelfPatient
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "self.patient@example.com",
  "password": "TestPass123!"
}


### 33. Check the patient account and role
GET {{host}}/api/auth/me
Authorization: Bearer {{loginSelfPatient.response.body.$.data.token}}


### 34. Run the reminder check
# The test appointments are more than 24 hours away, so this should report sent: 0.
POST {{host}}/api/reminders/run
Authorization: Bearer {{loginSuperAdmin.response.body.$.data.token}}